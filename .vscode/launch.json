{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'cryptod'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=cryptod",
                    "--package=cryptod"
                ]
            },
            "args": []
        },
        
        {
            "name": "Debug GTest",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/client/build/test/cryptod_client_tests",
            "cwd": "${workspaceFolder}/client/build/test",
            "arguments": "--gtest_filter=OsslMacTest.HmacSha256KnownVector",
            "gdbpath": "/usr/bin/gdb",
            "valuesFormatting": "parseText",
            "autorun": [
                "set env LD_LIBRARY_PATH /workspaces/cryptod/openssl",
                "set env OPENSSL_MODULES /workspaces/cryptod/client/build/ossl_provider"
            ]
        },
        {
            "name": "TLS-PSK Client",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/openssl/apps/openssl",
            "cwd": "${workspaceFolder}/client/build/test",
            "arguments": "s_client -tls1_2 -psk 41424344 -psk_identity Client_identity -cipher PSK-AES256-CBC-SHA -connect localhost:4433 -provider-path /workspaces/cryptod/client/build/ossl_provider/ -provider libcryptod_provider -provider default -propquery '?provider=libcryptod_provider' -debug -msg",
            "gdbpath": "/usr/bin/gdb",
            "valuesFormatting": "parseText",
            "autorun": [
                "set env LD_LIBRARY_PATH /workspaces/cryptod/openssl",
                "set env OPENSSL_MODULES /workspaces/cryptod/client/build/ossl_provider"
            ]
        },
        {
            "name": "Debug openssl cli mac",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/openssl/apps/openssl",
            "cwd": "${workspaceFolder}/client/test",
            "arguments": "mac -provider libcryptod_provider -digest SHA256 -macopt \"key_label:key123\" HMAC < data.txt",
            "gdbpath": "/usr/bin/gdb",
            "valuesFormatting": "parseText",
            "autorun": [
                "set env LD_LIBRARY_PATH /workspaces/cryptod/openssl",
                "set env OPENSSL_MODULES /workspaces/cryptod/client/build/ossl_provider"
            ]
        }        
    ]
}
