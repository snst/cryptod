openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
#alg_section = algorithm_sect

[provider_sect]
default = default_sect
libcryptod_provider = myprovider_sect

[default_sect]
activate = 1

[myprovider_sect]
module = /workspaces/cryptod/client/build/ossl_provider/libcryptod_provider.so
activate = 1

#[algorithm_sect]
#default_properties = ?provider=libcryptod_provider
